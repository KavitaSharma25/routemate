{
  "name": "routemate-root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev-backend": "cd backend ; npm run dev",
    "dev-frontend": "cd frontend ; npm run dev",
    "dev": "concurrently \"npm:dev-backend\" \"npm:dev-frontend\"",
    "install-all": "cd backend ; npm install ; cd ../frontend ; npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
